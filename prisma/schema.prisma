// Prisma schema for Website Keluarga Besar Wirjodihardjo
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────
// Enums
// ──────────────────────────────────────

enum Role {
  SUPER_ADMIN
  BRANCH_ADMIN
  MEMBER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ParentRole {
  FATHER
  MOTHER
  UNKNOWN
}

enum PartnerStatus {
  MARRIED
  DIVORCED
  WIDOWED
  UNKNOWN
}

enum SubmissionType {
  ADD_CHILD
  ADD_SPOUSE
  ADD_PERSON
  EDIT_PERSON
  EDIT_RELATION
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum MediaStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReunionStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum RegistrationStatus {
  CONFIRMED
  CANCELLED
  WAITLIST
}

enum EntryType {
  ACHIEVEMENT
  IN_MEMORIAM
}

enum ArticleStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ImportStatus {
  VALIDATED
  COMMITTED
  PARTIAL
  FAILED
}

// ──────────────────────────────────────
// Genealogy core
// ──────────────────────────────────────

model Branch {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  description   String?
  coverImageUrl String?
  orderIndex    Int      @default(0)
  branchNumber  Int      @unique
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rootPersonId String? @unique
  rootPerson   Person? @relation("BranchRoot", fields: [rootPersonId], references: [id])

  adminId String? @unique
  admin   User?   @relation("BranchAdmin", fields: [adminId], references: [id])

  members               Person[]               @relation("PersonBranch")
  governanceAssignments GovernanceAssignment[]
  branchRepresentatives BranchRepresentative[]
  registrationBatches   RegistrationBatch[]
}

model Person {
  id                 String    @id @default(uuid())
  externalRef        String?   @unique
  fullName           String
  nickname           String?
  namaPanggilan      String?
  slug               String?   @unique
  gender             Gender
  birthDate          DateTime?
  birthDatePrecision String?
  birthPlace         String?
  deathDate          DateTime?
  deathPlace         String?
  isDeceased         Boolean   @default(false)
  isMarriedInto      Boolean   @default(false)
  bio                String?
  occupation         String?
  status             String?
  photoUrl           String?
  generationLevel    Int?
  isPublicProfile    Boolean   @default(true)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  branchId     String?
  branch       Branch? @relation("PersonBranch", fields: [branchId], references: [id])
  rootedBranch Branch? @relation("BranchRoot")

  // Jejak asal data: baris ini dibuat lewat form publik /registrasi atau impor
  // Excel registrasi. Kosong berarti anggota berasal dari jalur lain (seed,
  // silsilah, impor anggota). Dipakai tabel publik untuk menandai baris baru.
  registrationBatchId String?
  registrationBatch   RegistrationBatch? @relation("RegistrationBatchPersons", fields: [registrationBatchId], references: [id])

  private  PersonPrivate?
  user     User?
  statuses PersonStatus[]

  parents  PersonChild[] @relation("AsChild")
  children PersonChild[] @relation("AsParent")

  partnershipsA PersonPartner[] @relation("PartnerA")
  partnershipsB PersonPartner[] @relation("PartnerB")

  submissions               Submission[]           @relation("SubmissionApplied")
  hallOfFameEntries         HallOfFameEntry[]
  galleryMedia              GalleryMedia[]
  adminNotes                AdminNote[]
  targetOf                  Submission[]           @relation("SubmissionTarget")
  articles                  Article[]
  education                 Education[]
  socialLinks               SocialLink[]
  governanceAssignments     GovernanceAssignment[] @relation("PersonGovernanceAssignments")
  branchRepresentativeSlots BranchRepresentative[] @relation("PersonBranchRepresentatives")

  @@index([fullName])
  @@index([slug])
  @@index([branchId])
  @@index([generationLevel])
  @@index([isDeceased])
  @@index([deletedAt])
}

model PersonPrivate {
  personId         String   @id
  person           Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  addressLine      String?
  city             String?
  province         String?
  postalCode       String?
  phone            String?
  whatsapp         String?
  email            String?
  maritalStatus    String?
  familyNotes      String?
  visibleToMembers Boolean  @default(true)
  updatedAt        DateTime @updatedAt
}

// Riwayat status singkat seseorang, misalnya kabar terkini.
model PersonStatus {
  id        String   @id @default(uuid())
  message   String
  createdAt DateTime @default(now())

  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, createdAt])
}

model PersonChild {
  id                 String     @id @default(uuid())
  parentId           String
  childId            String
  parentRole         ParentRole @default(UNKNOWN)
  isAdopted          Boolean    @default(false)
  isStep             Boolean    @default(false)
  orderIndex         Int        @default(0)
  createdAt          DateTime   @default(now())
  sourceSubmissionId String?

  parent     Person      @relation("AsParent", fields: [parentId], references: [id], onDelete: Cascade)
  child      Person      @relation("AsChild", fields: [childId], references: [id], onDelete: Cascade)
  submission Submission? @relation("ChildSubmission", fields: [sourceSubmissionId], references: [id])

  @@unique([parentId, childId])
  @@index([parentId, orderIndex])
  @@index([childId])
  @@index([sourceSubmissionId])
}

model PersonPartner {
  id           String        @id @default(uuid())
  partnerAId   String
  partnerBId   String
  marriageDate DateTime?
  divorceDate  DateTime?
  status       PartnerStatus @default(MARRIED)
  orderIndex   Int           @default(0)
  notes        String?
  createdAt    DateTime      @default(now())

  partnerA Person @relation("PartnerA", fields: [partnerAId], references: [id], onDelete: Cascade)
  partnerB Person @relation("PartnerB", fields: [partnerBId], references: [id], onDelete: Cascade)

  @@unique([partnerAId, partnerBId])
  @@index([partnerBId])
  @@index([orderIndex])
}

// ──────────────────────────────────────
// Accounts & authorization
// ──────────────────────────────────────

model User {
  id                   String    @id @default(uuid())
  username             String    @unique
  email                String?   @unique
  passwordHash         String
  role                 Role      @default(MEMBER)
  isVerified           Boolean   @default(false)
  isActive             Boolean   @default(true)
  mustChangePassword   Boolean   @default(false)
  mustChangeCredentials Boolean  @default(true)
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?
  lastLoginAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  personId String @unique
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  branchAdminOf Branch? @relation("BranchAdmin")

  createdById  String?
  createdBy    User?   @relation("UserCreator", fields: [createdById], references: [id])
  createdUsers User[]  @relation("UserCreator")

  submissions          Submission[]          @relation("Submitter")
  reviewedSubmissions  Submission[]          @relation("Reviewer")
  albums               Album[]               @relation("AlbumCreator")
  publishedAlbums      Album[]               @relation("AlbumPublisher")
  galleryUploads       GalleryMedia[]        @relation("MediaUploader")
  moderatedMedia       GalleryMedia[]        @relation("MediaModerator")
  hallOfFameEntries    HallOfFameEntry[]     @relation("EntryCreator")
  reunions             Reunion[]             @relation("ReunionCreator")
  reunionRegistrations ReunionRegistration[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  adminNotes           AdminNote[]

  importBatches                   ImportBatch[]          @relation("ImportCreator")
  articles                        Article[]              @relation("ArticleAuthor")
  reviewedArticles                Article[]              @relation("ArticleReviewer")
  governanceAssignments           GovernanceAssignment[] @relation("AssignmentCreator")
  branchRepresentativeAssignments BranchRepresentative[] @relation("BranchRepresentativeCreator")

  @@index([email])
  @@index([role])
}

// ──────────────────────────────────────
// Approval workflow
// ──────────────────────────────────────

model Submission {
  id         String           @id @default(uuid())
  type       SubmissionType
  payload    Json
  status     SubmissionStatus @default(PENDING)
  reviewNote String?
  reviewedAt DateTime?
  createdAt  DateTime         @default(now())

  submittedByUserId String
  submitter         User   @relation("Submitter", fields: [submittedByUserId], references: [id])

  targetPersonId String?
  targetPerson   Person? @relation("SubmissionTarget", fields: [targetPersonId], references: [id])

  appliedPersonId String?
  appliedPerson   Person? @relation("SubmissionApplied", fields: [appliedPersonId], references: [id])

  reviewedByUserId String?
  reviewer         User?   @relation("Reviewer", fields: [reviewedByUserId], references: [id])

  childEdges PersonChild[] @relation("ChildSubmission")

  @@index([status])
  @@index([submittedByUserId])
  @@index([targetPersonId])
}

// ──────────────────────────────────────
// Gallery
// ──────────────────────────────────────

model Album {
  id            String    @id @default(uuid())
  title         String
  slug          String    @unique
  description   String?
  eventDate     DateTime?
  coverImageUrl String?
  isPublished   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  createdByUserId   String
  createdBy         User           @relation("AlbumCreator", fields: [createdByUserId], references: [id])
  publishedByUserId String?
  publishedBy       User?          @relation("AlbumPublisher", fields: [publishedByUserId], references: [id])
  publishedAt       DateTime?
  media             GalleryMedia[]

  @@index([slug])
}

model GalleryMedia {
  id           String      @id @default(uuid())
  url          String
  thumbnailUrl String?
  caption      String?
  mediaType    String      @default("IMAGE")
  width        Int?
  height       Int?
  status       MediaStatus @default(PENDING)
  createdAt    DateTime    @default(now())

  albumId String
  album   Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)

  uploadedByUserId String?
  uploader         User?   @relation("MediaUploader", fields: [uploadedByUserId], references: [id])

  moderatedByUserId String?
  moderatedBy       User?     @relation("MediaModerator", fields: [moderatedByUserId], references: [id])
  moderatedAt       DateTime?
  rejectionReason   String?

  personId String?
  person   Person? @relation(fields: [personId], references: [id])

  @@index([albumId])
  @@index([status])
  @@index([moderatedByUserId])
}

// ──────────────────────────────────────
// Hall of Fame
// ──────────────────────────────────────

model HallOfFameEntry {
  id          String    @id @default(uuid())
  category    String
  title       String
  description String
  year        Int?
  photoUrl    String?
  entryType   EntryType @default(ACHIEVEMENT)
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  createdByUserId String
  createdBy       User   @relation("EntryCreator", fields: [createdByUserId], references: [id])

  @@index([category])
  @@index([isPublished])
}

// ──────────────────────────────────────
// Reunions
// ──────────────────────────────────────

model Reunion {
  id                   String        @id @default(uuid())
  title                String
  slug                 String        @unique
  description          String?
  // Tanggal boleh kosong: jadwal bisa belum ditetapkan saat reuni diumumkan.
  // Selama startAt null, pendaftaran tetap dibuka.
  startAt              DateTime?
  endAt                DateTime?
  locationName         String?
  locationUrl          String?
  capacity             Int?
  registrationDeadline DateTime?
  heroImageUrl         String?
  status               ReunionStatus @default(DRAFT)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  createdByUserId String
  createdBy       User   @relation("ReunionCreator", fields: [createdByUserId], references: [id])

  registrations ReunionRegistration[]

  @@index([status])
  @@index([startAt])
}

model ReunionRegistration {
  id         String             @id @default(uuid())
  guestCount Int                @default(1)
  notes      String?
  status     RegistrationStatus @default(CONFIRMED)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  reunionId String
  reunion   Reunion @relation(fields: [reunionId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reunionId, userId])
}

// ──────────────────────────────────────
// Registrasi keluarga (form publik)
// ──────────────────────────────────────

// Jejak satu kiriman form registrasi publik: cabang asal, jumlah baris,
// akun yang dibuat, dan peserta reuni. Dipakai untuk audit + statistik.
model RegistrationBatch {
  id            String   @id @default(uuid())
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  rowCount      Int      @default(0)
  accountsMade  Int      @default(0)
  attendees     Int      @default(0)
  submittedAt   DateTime @default(now())
  submitterIp   String?
  notes         String?

  // Person yang dibuat oleh batch ini. Jarak nullable: data lama tidak punya
  // batch, dan batch impor bisa dihapus tanpa menghapus orangnya.
  persons Person[] @relation("RegistrationBatchPersons")

  @@index([branchId])
  @@index([submittedAt])
}

// ──────────────────────────────────────
// System
// ──────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  type      String
  title     String
  body      String?
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String?
  beforeData Json?
  afterData  Json?
  actorLabel String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actorUserId String?
  actor       User?   @relation(fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
}

model AdminNote {
  id        String   @id @default(uuid())
  body      String
  createdAt DateTime @default(now())

  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  @@index([personId])
}

// Seeded reference table, generation names per Javanese tradition
model GenerationLabel {
  level     Int     @id
  jawa      String
  indonesia String?
}

// ──────────────────────────────────────
// Bulk import
// ──────────────────────────────────────

model ImportBatch {
  id          String       @id @default(uuid())
  type        String       @default("PERSON_FULL")
  filename    String
  status      ImportStatus @default(VALIDATED)
  totalRows   Int          @default(0)
  successRows Int          @default(0)
  errorRows   Int          @default(0)
  reportJson  Json?
  createdAt   DateTime     @default(now())

  createdById String
  createdBy   User   @relation("ImportCreator", fields: [createdById], references: [id])

  @@index([status])
  @@index([createdById])
}

// ──────────────────────────────────────
// Articles & stories
// ──────────────────────────────────────

model ArticleCategory {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  articles Article[]

  createdAt DateTime @default(now())
}

model Article {
  id          String        @id @default(uuid())
  title       String
  slug        String        @unique
  body        String
  excerpt     String?
  youtubeUrl  String?
  photoUrl    String?
  status      ArticleStatus @default(PENDING)
  reviewNote  String?
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  authorUserId String
  author       User   @relation("ArticleAuthor", fields: [authorUserId], references: [id])

  reviewedByUserId String?
  reviewedBy       User?     @relation("ArticleReviewer", fields: [reviewedByUserId], references: [id])
  reviewedAt       DateTime?

  categoryId String
  category   ArticleCategory @relation(fields: [categoryId], references: [id])

  personId String?
  person   Person? @relation(fields: [personId], references: [id])

  @@index([status])
  @@index([slug])
  @@index([authorUserId])
  @@index([categoryId])
}

// ──────────────────────────────────────
// Profiles & social
// ──────────────────────────────────────

model Education {
  id           String   @id @default(uuid())
  institution  String
  degree       String?
  fieldOfStudy String?
  startYear    Int?
  endYear      Int?
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
}

model SocialPlatform {
  id        String   @id @default(uuid())
  name      String   @unique
  baseUrl   String?
  iconName  String?
  createdAt DateTime @default(now())

  links SocialLink[]
}

model SocialLink {
  id        String   @id @default(uuid())
  url       String
  username  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  platformId String
  platform   SocialPlatform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@index([platformId])
}

// ──────────────────────────────────────
// Governance
// ──────────────────────────────────────

model GovernanceStructure {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  positions GovernancePosition[]

  @@index([isActive])
  @@index([startDate])
}

model GovernancePosition {
  id                     String   @id @default(uuid())
  name                   String
  description            String?
  level                  Int      @default(0)
  capacity               Int?
  isBranchRepresentative Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  structureId String
  structure   GovernanceStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)

  parentPositionId String?
  parentPosition   GovernancePosition?  @relation("PositionHierarchy", fields: [parentPositionId], references: [id])
  childPositions   GovernancePosition[] @relation("PositionHierarchy")

  assignments GovernanceAssignment[]

  @@index([structureId])
  @@index([parentPositionId])
  @@index([isBranchRepresentative])
}

model GovernanceAssignment {
  id        String    @id @default(uuid())
  startDate DateTime
  endDate   DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  positionId String
  position   GovernancePosition @relation(fields: [positionId], references: [id], onDelete: Cascade)

  personId String
  person   Person @relation("PersonGovernanceAssignments", fields: [personId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  assignedByUserId String
  assignedBy       User   @relation("AssignmentCreator", fields: [assignedByUserId], references: [id])

  @@index([positionId])
  @@index([personId])
  @@index([branchId])
  @@index([assignedByUserId])
  @@index([startDate])
}

model BranchRepresentative {
  id        String    @id @default(uuid())
  slot      Int
  startDate DateTime
  endDate   DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  personId String
  person   Person @relation("PersonBranchRepresentatives", fields: [personId], references: [id], onDelete: Cascade)

  assignedByUserId String
  assignedBy       User   @relation("BranchRepresentativeCreator", fields: [assignedByUserId], references: [id])

  @@unique([branchId, slot])
  @@index([branchId])
  @@index([personId])
  @@index([assignedByUserId])
  @@index([startDate])
}
