# Template lingkungan pengembangan wd-dev.
# Salin menjadi `.env.dev` lalu isi NEXTAUTH_SECRET dengan string acak.
# Berkas `.env.dev` berisi rahasia dev dan TIDAK boleh di-commit.

# Database PostgreSQL (container wd-dev-db di network teknoloka-network)
DATABASE_URL="postgresql://wirjo:wirjo_secret@wd-dev-db:5432/wirjodihardjo"

# NextAuth
NEXTAUTH_URL="https://wd.teknoloka.id"
NEXTAUTH_SECRET="ganti-dengan-string-acak-khusus-dev"
AUTH_TRUST_HOST="true"

# Redis (container wd-dev-redis)
REDIS_URL="redis://wd-dev-redis:6379"

# Direktori penyimpanan unggahan foto
UPLOAD_DIR="/app/uploads"

# Kredensial UploadThing (opsional, kosongkan bila tidak dipakai)
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""
